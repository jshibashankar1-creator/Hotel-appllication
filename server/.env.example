# ===================================================
# HOTELHUB BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ===================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# MongoDB Database Connection URI (Supports Local MongoDB or MongoDB Atlas Cloud)
MONGODB_URI=mongodb://localhost:27017/hotelhub
DATABASE_URI=mongodb://localhost:27017/hotelhub
DATABASE_FILE=./src/db/database.json

# JWT Authentication Secret & Token Lifecycle
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*

# Platform Business Rules
DEFAULT_COMMISSION_RATE=15
DEFAULT_CANCEL_FEE_PCT=10

# Support Desk Contacts
SUPPORT_EMAIL=support@hotelhub.com
SUPPORT_PHONE=+91 98000 12345

# Razorpay Payment Gateway Configuration (Test Mode / Live Mode)
# In Razorpay Dashboard -> Settings -> API Keys:
# Generate Key ID and Key Secret as a matching pair.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
PAYMENT_PROVIDER_MODE=test

# Cloudinary Storage Configuration (Server-Side Room Photos & Assets)
# Retrieve Cloud Name, API Key, and API Secret from Cloudinary Dashboard -> Settings -> Access Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
